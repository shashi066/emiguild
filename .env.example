# Environment Variables — Copy this to .env.local and fill in the values
# DO NOT commit .env.local to Git

# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Get these from your Neon dashboard → Project → Connection Details
# Select "Prisma" from the dropdown to get the correct format

# Pooled connection (used by Vercel serverless functions)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection (used by Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Your Vercel URL (set AFTER first deployment — copy from Vercel dashboard)
NEXTAUTH_URL="https://your-app-name.vercel.app"

# ── Admin Notifications (Gmail SMTP via Nodemailer) ───────────────────────────
# Your Gmail address used as the sender
GMAIL_USER="yourgmail@gmail.com"
# Gmail App Password (NOT your regular password)
# How to get it: https://myaccount.google.com/apppasswords
#   1. Enable 2-Step Verification on your Google account
#   2. Go to myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail"
#   4. Paste the 16-character code here (no spaces)
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Email address that will receive booking notifications (can be same as GMAIL_USER)
ADMIN_NOTIFY_EMAIL="yourgmail@gmail.com"

# Used when running: npm run db:seed
ADMIN_EMAIL="admin@yourgamingcafe.com"
ADMIN_PASSWORD="YourStrongPassword123!"

NEXT_PUBLIC_PHONE_SECRET_KEY=your_secret_key_here

# EmiGuild customer assistant (server-only)
# Configure the OpenAI API key, model and daily AI limit in Admin > Settings > Emiily AI.
# API keys are encrypted with the existing AUTH_SECRET. Re-enter the key after rotating AUTH_SECRET.
# Action tokens use a key derived from AUTH_SECRET by default.
# AI chat requires sign-in; the default is 10 requests/day per account (midnight IST).
# Legacy ASSISTANT_USER_DAILY_LIMIT / ASSISTANT_ANONYMOUS_DAILY_LIMIT values are ignored.
ASSISTANT_GUIDED_PER_MINUTE_LIMIT="60"

# Watch Party fixtures are loaded from data/watch-party/premier-league-2026-27-fixtures.json.
